// ================== НАСТРОЙКИ ==================
// Когда начнётся фестиваль: год-месяц-деньTчасы:минуты:секунды
const EVENT_DATE = '2027-07-17T16:00:00';

// ================== ДАННЫЕ: исполнители ==================
// group нужен для фильтра: 'main' или 'other'
const artists = [
  { name: '[Артист 1]', genre: '[Жанр]', group: 'main', emoji: '🎤', tracks: ['[Трек 1]', '[Трек 2]', '[Трек 3]'] },
  { name: '[Артист 2]', genre: '[Жанр]', group: 'main', emoji: '🎧', tracks: ['[Трек 1]', '[Трек 2]', '[Трек 3]'] },
  { name: '[Артист 3]', genre: '[Жанр]', group: 'other', emoji: '🎸', tracks: ['[Трек 1]', '[Трек 2]', '[Трек 3]'] }
];

const tickerTrack = document.querySelector(".ticker-track")
tickerTrack.innerHTML = artists.map(el => el.name).join(" ★ ")

// ================== [1] ТЕМЫ (делаем вместе) ==================
// Кнопки .theme-btn меняют класс у <body>.
// Подсказка: document.body.className = btn.dataset.theme
